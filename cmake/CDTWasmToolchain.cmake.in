message(STATUS "Setting up CDT Wasm Toolchain @VERSION_FULL@ at @CDT_ROOT_DIR@")

set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR wasm)
set(CMAKE_CROSSCOMPILING 1)
set(CMAKE_C_COMPILER_WORKS 1)
set(CMAKE_CXX_COMPILER_WORKS 1)
  
set(CDT_VERSION "@VERSION_FULL@")
set(WASMSDK_VERSION "@VERSION_FULL@")

set(CMAKE_C_COMPILER "@CDT_ROOT_DIR@/bin/cdt-cc")
set(CMAKE_CXX_COMPILER "@CDT_ROOT_DIR@/bin/cdt-cpp")
set(CMAKE_ASM_COMPILER "@CDT_ROOT_DIR@/bin/cdt-cc")
set(CMAKE_AR "@CDT_ROOT_DIR@/bin/cdt-ar")
set(CMAKE_RANLIB "@CDT_ROOT_DIR@/bin/cdt-ranlib")

# ccache 4.14 regressed preprocessing through the CDT compiler wrappers. Only
# CDT's internal runtime-library build opts in to dependency-mode caching, and
# it assigns native targets a separate cache directory. Contract builds remain
# uncached because the compiler wrappers also produce side files.
if(NOT CDT_INTERNAL_LIBRARY_BUILD OR NOT CDT_NATIVE_CCACHE_DIR)
  set(CMAKE_C_COMPILER_LAUNCHER "" CACHE STRING "Compiler launchers are unsupported by the CDT toolchain" FORCE)
  set(CMAKE_CXX_COMPILER_LAUNCHER "" CACHE STRING "Compiler launchers are unsupported by the CDT toolchain" FORCE)
endif()

# Toolchain files are evaluated before project(), but CMAKE_SOURCE_DIR is
# already set from the consumer's -S source directory before the toolchain loads.
set(_CDT_SOURCE_PREFIX_MAP "-ffile-prefix-map=${CMAKE_SOURCE_DIR}=.")
set(CMAKE_C_FLAGS "-Os ${_CDT_SOURCE_PREFIX_MAP}")
set(CMAKE_CXX_FLAGS "-Os ${_CDT_SOURCE_PREFIX_MAP}")
set(CMAKE_ASM_FLAGS "-fnative -fasm")

set(WASM_LINKER "@CDT_ROOT_DIR@/bin/cdt-ld")

set(CMAKE_C_LINK_EXECUTABLE "${WASM_LINKER} <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")
set(CMAKE_CXX_LINK_EXECUTABLE "${WASM_LINKER} <LINK_FLAGS> <OBJECTS> -o <TARGET> <LINK_LIBRARIES>")

set(CMAKE_EXECUTABLE_SUFFIX_C ".wasm")
set(CMAKE_EXECUTABLE_SUFFIX_CXX ".wasm")

set(CMAKE_FIND_ROOT_PATH "@CDT_ROOT_DIR@")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(ABIGEN "@CDT_ROOT_DIR@/bin/cdt-abigen")

# hack for OSX
set(CMAKE_OSX_SYSROOT="@SYSROOT_DIR@")
set(CMAKE_OSX_DEPLOYMENT_TARGET="")

# ADD ANY PROVIDED INCLUDE DIRECTORIES
# `-DCDT_CONTRACT_INCLUDE_PATH=<semicolon delimited include paths>`
if(IS_DIRECTORY ${CDT_CONTRACT_INCLUDE_PATH})
  message(NOTICE "Adding CDT contract include path: ${CDT_CONTRACT_INCLUDE_PATH}")
  include_directories(BEFORE ${CDT_CONTRACT_INCLUDE_PATH})
endif()
