// Declares clang::SyntaxOnlyAction.
#include "clang/Frontend/FrontendActions.h"
#include "clang/Tooling/CommonOptionsParser.h"
#include "clang/Tooling/Tooling.h"
#include <fstream>
#include <iostream>
#include <map>
#include <set>
#include <sstream>
#include <vector>

// Declares llvm::cl::extrahelp.
#include "llvm/Support/CommandLine.h"
#include "llvm/Support/FileSystem.h"
#include "llvm/Support/Path.h"
using namespace clang::tooling;
using namespace llvm;
#define ONLY_LD
#include <compiler_options.hpp>

namespace {
// Substrings that, if present in wasm-ld stderr, indicate the contract is reaching
// softfloat-backed compiler builtins without --use-rt. Two layers:
//   1. compiler-rt entry points (__multf3, __fixtfti, ...) -- unresolved if librt.a
//      itself isn't linked. Default link includes -lrt, so this layer typically does
//      not fire, but the names are listed for robustness in custom link setups.
//   2. softfloat helpers (f128_mul, ui64_to_f128, ...) -- unresolved when librt.a
//      IS linked (default) but libsf.a is not (opt-in via --use-rt). librt's
//      __multf3 etc. delegate into these helpers, so this is the layer typically
//      seen in practice.
constexpr const char* softfloat_builtin_triggers[] = {
   // Layer 1: compiler-rt entry points
   "__addtf3", "__subtf3", "__multf3", "__divtf3", "__negtf2",
   "__eqtf2",  "__netf2",  "__getf2",  "__gttf2",  "__lttf2",
   "__letf2",  "__cmptf2", "__unordtf2",
   "__floatsitf",  "__floatunsitf",  "__floatditf",  "__floatunditf",
   "__floattidf",  "__floatuntidf",  "__floatsidf",
   "__extendsftf2", "__extenddftf2",
   "__fixtfti",   "__fixtfdi",   "__fixtfsi",
   "__fixunstfti","__fixunstfdi","__fixunstfsi",
   "__fixsfti",   "__fixdfti",   "__fixunssfti","__fixunsdfti",
   "__trunctfdf2","__trunctfsf2",
   // Layer 2: softfloat helper substrings (f128_mul, f128_to_f64, ui64_to_f128, ...)
   "f128_", "i32_to_f", "i64_to_f", "ui32_to_f", "ui64_to_f",
   "f32_to_f128", "f64_to_f128",
};

// Replays captured wasm-ld stderr to the terminal, then returns true if any
// softfloat-builtin trigger symbol appeared in the output.
bool replay_stderr_and_check_softfloat(const std::string& stderr_path) {
   std::ifstream in(stderr_path);
   if (!in)
      return false;
   std::string contents((std::istreambuf_iterator<char>(in)),
                         std::istreambuf_iterator<char>());
   std::cerr << contents;
   for (const char* sym : softfloat_builtin_triggers) {
      if (contents.find(sym) != std::string::npos)
         return true;
   }
   return false;
}

// Link-time finalize: publish the complete contract ABI + a single strong dispatcher.
//
// The per-TU compiles (cdt-cpp --emit-desc-only -> cdt-codegen) wrote each TU's .desc and
// a "<contract>.finalize" manifest into the object directory, but deferred the shared
// <contract>.abi and the contract apply() dispatcher to here -- where, now that every
// object (hence every .desc) exists, the complete descriptor set is available. Running the
// finalize once eliminates the parallel-build races entirely: no per-TU shared writes, no
// sibling-.desc reads during compilation, and the dispatcher is always complete (a single
// strong apply() that overrides any per-TU stub). Best-effort: if no manifest is found this
// is not a contract link, and we leave the link unchanged.
void run_link_time_finalize(Options& opts) {
   namespace fs = llvm::sys::fs;

   // 1. Find the object directory(ies) and the finalize manifest.
   std::set<std::string> obj_dirs;
   for (const auto& a : opts.ld_options) {
      llvm::StringRef ar(a);
      if (ar.ends_with(".o") || ar.ends_with(".obj")) // CMake uses .o or .obj
         obj_dirs.insert(std::string(llvm::sys::path::parent_path(ar)));
   }
   std::string manifest_path;
   for (const auto& dir : obj_dirs) {
      std::error_code ec;
      for (fs::directory_iterator it(dir, ec), end; it != end && !ec; it.increment(ec)) {
         if (llvm::StringRef(it->path()).ends_with(".finalize")) { manifest_path = it->path(); break; }
      }
      if (!manifest_path.empty()) break;
   }
   if (manifest_path.empty())
      return; // not a contract link

   // 2. Read the manifest (key=value lines).
   std::map<std::string, std::string> m;
   {
      std::ifstream in(manifest_path);
      std::string line;
      while (std::getline(in, line)) {
         auto eq = line.find('=');
         if (eq != std::string::npos)
            m[line.substr(0, eq)] = line.substr(eq + 1);
      }
   }
   const std::string contract   = m["contract"];
   const std::string output_dir = m["output_dir"];
   if (contract.empty() || output_dir.empty())
      return;

   // 3. Publish the complete ABI + a strong standalone dispatch.cpp from every .desc.
   std::vector<std::string> cg = {"--finalize", "--contract", contract, "--output-dir", output_dir};
   if (!m["abi_output"].empty())     { cg.push_back("--abi-output");     cg.push_back(m["abi_output"]); }
   if (!m["abi_version"].empty())    { cg.push_back("--abi-version");    cg.push_back(m["abi_version"]); }
   if (m["no_abigen"] == "1")        { cg.push_back("--no-abigen"); }
   if (!m["protobuf_dir"].empty())   { cg.push_back("--protobuf-dir");   cg.push_back(m["protobuf_dir"]); }
   if (!m["protobuf_files"].empty()) { cg.push_back("--protobuf-files"); cg.push_back(m["protobuf_files"]); }
   if (!sysio::cdt::environment::exec_subprogram("cdt-codegen", cg)) {
      std::cerr << "cdt-ld: link-time ABI/dispatch finalize failed" << std::endl;
      return;
   }

   // 4. If a dispatcher was generated (contract did not define its own apply()), compile it
   //    with the same flags the TUs used and add it to the link.
   const std::string dispatch_cpp = output_dir + "/" + contract + ".dispatch.cpp";
   if (!fs::exists(dispatch_cpp))
      return;
   const std::string dispatch_obj = output_dir + "/" + contract + ".dispatch.cpp.o";
   // Compile the generated dispatcher with the contract's own clang flags (recorded in the
   // manifest), minus the abigen plugins and dependency-file flags that apply only to the
   // per-TU sources. Invoke clang++ directly -- cdt-cpp has its own option parser and rejects
   // raw clang flags such as -ferror-limit.
   std::vector<std::string> cc;
   {
      std::vector<std::string> toks;
      { std::stringstream ss(m["cxx"]); std::string t; while (ss >> t) toks.push_back(t); }
      for (size_t i = 0; i < toks.size(); ++i) {
         const std::string& t = toks[i];
         if (t.rfind("-fplugin=", 0) == 0) continue;                   // abigen/attribute plugins
         if (t == "-Xclang") { ++i; continue; }                        // drops the -add-plugin wiring
         if (t == "-MF" || t == "-MT" || t == "-MQ") { ++i; continue; } // per-TU dependency file
         if (t == "-MD" || t == "-MMD" || t == "-MP" || t == "-M" || t == "-MM") continue;
         if (t == "-c") continue;                                      // re-added below
         if (t == "-o") { ++i; continue; }                             // re-added below
         cc.push_back(t);
      }
   }
   cc.push_back("-c");
   cc.push_back(dispatch_cpp);
   cc.push_back("-o");
   cc.push_back(dispatch_obj);
   if (!sysio::cdt::environment::exec_subprogram("clang++", cc)) {
      std::cerr << "cdt-ld: failed to compile the generated dispatcher" << std::endl;
      return;
   }
   // 5. Add the dispatcher object so wasm-ld's strong apply() overrides any per-TU stub.
   opts.ld_options.push_back(dispatch_obj);
}
} // namespace

int main(int argc, const char **argv) {

  cl::SetVersionPrinter([](llvm::raw_ostream& os) {
        os << "cdt-ld version " << "${VERSION_FULL}" << "\n";
  });
  cl::ParseCommandLineOptions(argc, argv, "cdt-ld (WebAssembly linker)");
  Options opts = CreateOptions();

  std::string line;
  if (opts.native) {
#ifdef __APPLE__
     if (!sysio::cdt::environment::exec_subprogram("ld", opts.ld_options, true))
#else
     if (!sysio::cdt::environment::exec_subprogram("ld.lld", opts.ld_options))
#endif
         return -1;
  } else {
      // Publish the complete contract ABI + a single strong dispatcher from every .desc
      // before linking (see run_link_time_finalize). No-op for non-contract links.
      run_link_time_finalize(opts);

      // Capture wasm-ld stderr so we can detect specific unresolved-symbol patterns
      // (softfloat builtins -> hint to pass --use-rt) and still echo the original
      // diagnostics through to the terminal.
      llvm::SmallString<64> stderr_path;
      if (llvm::sys::fs::createTemporaryFile("cdt-ld-stderr", "log", stderr_path)) {
         std::cerr << "cdt-ld: failed to create temp file for wasm-ld stderr capture" << std::endl;
         return -1;
      }
      auto delete_stderr = llvm::make_scope_exit([&]{ llvm::sys::fs::remove(stderr_path); });

      bool wasmld_ok = sysio::cdt::environment::exec_subprogram(
            "wasm-ld", opts.ld_options, false, std::nullopt, std::nullopt,
            std::string(stderr_path.str()));

      bool softfloat_unresolved = replay_stderr_and_check_softfloat(std::string(stderr_path.str()));

      if (!wasmld_ok) {
         std::cerr << "Exit due to wasm-ld failure" << std::endl;
         if (softfloat_unresolved && !use_rt_opt) {
            std::cerr << "\ncdt-ld: the contract references softfloat-backed compiler builtins\n"
                         "(long double / float128 ops). Pass --use-rt to link libsf into the\n"
                         "contract; it is opt-in because softfloat is large." << std::endl;
         }
         return -1;
      }
  }
  if ( !llvm::sys::fs::exists( opts.output_fn ) ) {
     std::cerr << "Exit due to failure to write file" << std::endl;
     return -1;
  }

  // finally any post processing
  if (!fno_post_pass_opt && !opts.native) {
     if ( !llvm::sys::fs::exists( opts.sysio_pp_dir+"/sysio-pp" ) ) {
        std::cerr << "Error: sysio.pp not found! (Try reinstalling sysio.cdt)" << std::endl;
        return -1;
     }

     if (!sysio::cdt::environment::exec_subprogram("sysio-pp", {opts.output_fn})) {
        std::cerr << "sysio-pp failed" << std::endl;
        return -1;
     }

     if ( !llvm::sys::fs::exists( opts.output_fn ) ) {
        std::cerr << "Exit due to failure to write file" << std::endl;
        return -1;
     }
   }
  return 0;
}
