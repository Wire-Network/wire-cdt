// Declares clang::SyntaxOnlyAction.
#include "clang/Frontend/FrontendActions.h"
#include "clang/Tooling/CommonOptionsParser.h"
#include "clang/Tooling/Tooling.h"
#include <fstream>
#include <iostream>
#include <map>
#include <set>
#include <sstream>
#include <vector>

// Declares llvm::cl::extrahelp.
#include "llvm/Support/CommandLine.h"
#include "llvm/Support/FileSystem.h"
#include "llvm/Support/Path.h"
using namespace clang::tooling;
using namespace llvm;
#define ONLY_LD
#include <compiler_options.hpp>

namespace {
// Substrings that, if present in wasm-ld stderr, indicate the contract is reaching
// softfloat-backed compiler builtins without --use-rt. Two layers:
//   1. compiler-rt entry points (__multf3, __fixtfti, ...) -- unresolved if librt.a
//      itself isn't linked. Default link includes -lrt, so this layer typically does
//      not fire, but the names are listed for robustness in custom link setups.
//   2. softfloat helpers (f128_mul, ui64_to_f128, ...) -- unresolved when librt.a
//      IS linked (default) but libsf.a is not (opt-in via --use-rt). librt's
//      __multf3 etc. delegate into these helpers, so this is the layer typically
//      seen in practice.
constexpr const char* softfloat_builtin_triggers[] = {
   // Layer 1: compiler-rt entry points
   "__addtf3", "__subtf3", "__multf3", "__divtf3", "__negtf2",
   "__eqtf2",  "__netf2",  "__getf2",  "__gttf2",  "__lttf2",
   "__letf2",  "__cmptf2", "__unordtf2",
   "__floatsitf",  "__floatunsitf",  "__floatditf",  "__floatunditf",
   "__floattidf",  "__floatuntidf",  "__floatsidf",
   "__extendsftf2", "__extenddftf2",
   "__fixtfti",   "__fixtfdi",   "__fixtfsi",
   "__fixunstfti","__fixunstfdi","__fixunstfsi",
   "__fixsfti",   "__fixdfti",   "__fixunssfti","__fixunsdfti",
   "__trunctfdf2","__trunctfsf2",
   // Layer 2: softfloat helper substrings (f128_mul, f128_to_f64, ui64_to_f128, ...)
   "f128_", "i32_to_f", "i64_to_f", "ui32_to_f", "ui64_to_f",
   "f32_to_f128", "f64_to_f128",
};

// Replays captured wasm-ld stderr to the terminal, then returns true if any
// softfloat-builtin trigger symbol appeared in the output.
bool replay_stderr_and_check_softfloat(const std::string& stderr_path) {
   std::ifstream in(stderr_path);
   if (!in)
      return false;
   std::string contents((std::istreambuf_iterator<char>(in)),
                         std::istreambuf_iterator<char>());
   std::cerr << contents;
   for (const char* sym : softfloat_builtin_triggers) {
      if (contents.find(sym) != std::string::npos)
         return true;
   }
   return false;
}

// Link-time finalize: publish the complete contract ABI + a single strong dispatcher.
//
// Object-driven: cdt-cpp wrote a per-object sidecar ("<object>.finalize") next to each compiled
// object, recording that object's descriptor and the shared finalize parameters. Here we walk
// the objects actually being linked, read their sidecars, and hand cdt-codegen the exact set of
// descriptors via repeated --desc-file options. This is robust where a directory scan is not:
// it only finalizes descriptors for linked objects, finds descriptors regardless of which source
// subdirectory they live in, and ignores stale files from removed sources. Running the finalize
// once also eliminates the parallel-build races -- no per-TU shared writes, no sibling-.desc
// reads during compilation, and the dispatcher is always a single complete strong apply().
//
// Returns true to proceed with the link: either no sidecar was found (not a contract link, leave
// it unchanged) or the finalize succeeded. Returns false on a hard failure once a contract has
// been identified -- finalize is solely responsible for the ABI and dispatcher, so a failure here
// must abort cdt-ld rather than let wasm-ld link stale or missing generated artifacts.
bool run_link_time_finalize(Options& opts) {
   namespace fs = llvm::sys::fs;

   // Shared finalize parameters, accumulated from the sidecars (all linked objects of one
   // contract must agree on them); cxx_args are the dispatcher compile flags (taken from the
   // first sidecar -- they agree modulo per-object dep-file/-o flags, which are filtered below).
   std::string contract, abi_output, dispatch_output, abi_version, no_abigen,
               protobuf_dir, protobuf_files;
   std::vector<std::string> desc_files; // one (or more) per linked object
   std::vector<std::string> cxx_args;
   bool found = false;

   auto agree = [](std::string& field, const std::string& val, const char* name,
                   const std::string& where) -> bool {
      if (val.empty()) return true;
      if (field.empty()) { field = val; return true; }
      if (field == val) return true;
      std::cerr << "cdt-ld: conflicting '" << name << "' across finalize sidecars in " << where
                << " ('" << field << "' vs '" << val << "')" << std::endl;
      return false;
   };

   // 1. Walk the linked objects; read the sidecar sitting next to each.
   for (const auto& a : opts.ld_options) {
      llvm::StringRef ar(a);
      if (!ar.ends_with(".o") && !ar.ends_with(".obj")) continue; // CMake uses .o or .obj
      const std::string sidecar = a + ".finalize";
      if (!fs::exists(sidecar)) continue;
      found = true;

      std::vector<std::string> this_cxx;
      std::ifstream in(sidecar);
      std::string line;
      while (std::getline(in, line)) {
         auto eq = line.find('=');
         if (eq == std::string::npos) continue;
         std::string key = line.substr(0, eq);
         std::string val = line.substr(eq + 1);
         if (key == "desc_file")            desc_files.push_back(std::move(val));
         else if (key == "cxxarg")          this_cxx.push_back(std::move(val));
         else if (key == "contract")        { if (!agree(contract, val, "contract", sidecar)) return false; }
         else if (key == "abi_output")      { if (!agree(abi_output, val, "abi_output", sidecar)) return false; }
         else if (key == "dispatch_output") { if (!agree(dispatch_output, val, "dispatch_output", sidecar)) return false; }
         else if (key == "abi_version")     { if (!agree(abi_version, val, "abi_version", sidecar)) return false; }
         else if (key == "no_abigen")       { if (!agree(no_abigen, val, "no_abigen", sidecar)) return false; }
         else if (key == "protobuf_dir")    { if (!agree(protobuf_dir, val, "protobuf_dir", sidecar)) return false; }
         else if (key == "protobuf_files")  { if (!agree(protobuf_files, val, "protobuf_files", sidecar)) return false; }
      }
      if (cxx_args.empty()) cxx_args = std::move(this_cxx);
   }

   if (!found)
      return true; // not a contract link -- leave the link unchanged
   if (contract.empty() || dispatch_output.empty() || desc_files.empty()) {
      std::cerr << "cdt-ld: finalize sidecar(s) missing contract/dispatch_output/desc_file" << std::endl;
      return false;
   }

   // 2. Publish the complete ABI + a strong dispatcher from exactly the linked objects' descriptors.
   std::vector<std::string> cg = {"--finalize", "--contract", contract,
                                  "--dispatch-output", dispatch_output};
   if (!abi_output.empty())     { cg.push_back("--abi-output");     cg.push_back(abi_output); }
   if (!abi_version.empty())    { cg.push_back("--abi-version");    cg.push_back(abi_version); }
   if (no_abigen == "1")        { cg.push_back("--no-abigen"); }
   if (!protobuf_dir.empty())   { cg.push_back("--protobuf-dir");   cg.push_back(protobuf_dir); }
   if (!protobuf_files.empty()) { cg.push_back("--protobuf-files"); cg.push_back(protobuf_files); }
   for (const auto& d : desc_files) { cg.push_back("--desc-file"); cg.push_back(d); }
   if (!sysio::cdt::environment::exec_subprogram("cdt-codegen", cg)) {
      std::cerr << "cdt-ld: link-time ABI/dispatch finalize failed" << std::endl;
      return false;
   }

   // 3. If a dispatcher was generated, compile it with the same flags the TUs used and add it to
   //    the link. finalize deletes any stale dispatcher and only writes one when the contract has
   //    actions/notifies and no user-defined apply(), so the file's presence reliably means it was
   //    generated this run -- its absence is success (the contract defines its own apply()).
   if (!fs::exists(dispatch_output))
      return true;
   const std::string dispatch_obj = dispatch_output + ".o";
   // Compile the generated dispatcher with the contract's own clang flags (from the sidecar),
   // minus the abigen plugins and per-object dependency-file/output flags. Invoke clang++
   // directly -- cdt-cpp has its own option parser and rejects raw clang flags like -ferror-limit.
   std::vector<std::string> cc;
   for (size_t i = 0; i < cxx_args.size(); ++i) {
      const std::string& t = cxx_args[i];
      if (t.rfind("-fplugin=", 0) == 0) continue;                      // abigen/attribute plugins
      // Clang plugin activation is the 4-token group "-Xclang -add-plugin -Xclang <name>"
      // (likewise "-Xclang -load -Xclang <path>"). Drop exactly those groups; any other
      // -Xclang option the contract passes is kept and forwarded to the dispatcher compile.
      if (t == "-Xclang" && i + 1 < cxx_args.size() &&
          (cxx_args[i + 1] == "-add-plugin" || cxx_args[i + 1] == "-load")) { i += 3; continue; }
      if (t == "-MF" || t == "-MT" || t == "-MQ" || t == "-MJ") { ++i; continue; } // dep-file (takes arg)
      if (t == "-MD" || t == "-MMD" || t == "-MP" || t == "-M" || t == "-MM" || t == "-MG") continue;
      if (t == "-c") continue;                                         // re-added below
      if (t == "-o") { ++i; continue; }                                // re-added below
      cc.push_back(t);
   }
   cc.push_back("-c");
   cc.push_back(dispatch_output);
   cc.push_back("-o");
   cc.push_back(dispatch_obj);
   if (!sysio::cdt::environment::exec_subprogram("clang++", cc)) {
      std::cerr << "cdt-ld: failed to compile the generated dispatcher" << std::endl;
      return false;
   }
   // 4. Add the dispatcher object so wasm-ld picks up the single strong apply().
   opts.ld_options.push_back(dispatch_obj);
   return true;
}
} // namespace

int main(int argc, const char **argv) {

  cl::SetVersionPrinter([](llvm::raw_ostream& os) {
        os << "cdt-ld version " << "${VERSION_FULL}" << "\n";
  });
  cl::ParseCommandLineOptions(argc, argv, "cdt-ld (WebAssembly linker)");
  Options opts = CreateOptions();

  std::string line;
  if (opts.native) {
#ifdef __APPLE__
     if (!sysio::cdt::environment::exec_subprogram("ld", opts.ld_options, true))
#else
     if (!sysio::cdt::environment::exec_subprogram("ld.lld", opts.ld_options))
#endif
         return -1;
  } else {
      // Publish the complete contract ABI + a single strong dispatcher from every .desc
      // before linking (see run_link_time_finalize). No-op for non-contract links; aborts the
      // link if finalize fails for an identified contract.
      if (!run_link_time_finalize(opts)) {
         std::cerr << "Exit due to link-time ABI/dispatch finalize failure" << std::endl;
         return -1;
      }

      // Capture wasm-ld stderr so we can detect specific unresolved-symbol patterns
      // (softfloat builtins -> hint to pass --use-rt) and still echo the original
      // diagnostics through to the terminal.
      llvm::SmallString<64> stderr_path;
      if (llvm::sys::fs::createTemporaryFile("cdt-ld-stderr", "log", stderr_path)) {
         std::cerr << "cdt-ld: failed to create temp file for wasm-ld stderr capture" << std::endl;
         return -1;
      }
      auto delete_stderr = llvm::make_scope_exit([&]{ llvm::sys::fs::remove(stderr_path); });

      bool wasmld_ok = sysio::cdt::environment::exec_subprogram(
            "wasm-ld", opts.ld_options, false, std::nullopt, std::nullopt,
            std::string(stderr_path.str()));

      bool softfloat_unresolved = replay_stderr_and_check_softfloat(std::string(stderr_path.str()));

      if (!wasmld_ok) {
         std::cerr << "Exit due to wasm-ld failure" << std::endl;
         if (softfloat_unresolved && !use_rt_opt) {
            std::cerr << "\ncdt-ld: the contract references softfloat-backed compiler builtins\n"
                         "(long double / float128 ops). Pass --use-rt to link libsf into the\n"
                         "contract; it is opt-in because softfloat is large." << std::endl;
         }
         return -1;
      }
  }
  if ( !llvm::sys::fs::exists( opts.output_fn ) ) {
     std::cerr << "Exit due to failure to write file" << std::endl;
     return -1;
  }

  // finally any post processing
  if (!fno_post_pass_opt && !opts.native) {
     if ( !llvm::sys::fs::exists( opts.sysio_pp_dir+"/sysio-pp" ) ) {
        std::cerr << "Error: sysio.pp not found! (Try reinstalling sysio.cdt)" << std::endl;
        return -1;
     }

     if (!sysio::cdt::environment::exec_subprogram("sysio-pp", {opts.output_fn})) {
        std::cerr << "sysio-pp failed" << std::endl;
        return -1;
     }

     if ( !llvm::sys::fs::exists( opts.output_fn ) ) {
        std::cerr << "Exit due to failure to write file" << std::endl;
        return -1;
     }
   }
  return 0;
}
