// Declares clang::SyntaxOnlyAction.
#include "clang/Frontend/FrontendActions.h"
#include "clang/Tooling/CommonOptionsParser.h"
#include "clang/Tooling/Tooling.h"

#include <iostream>
#include <sstream>

// Declares llvm::cl::extrahelp.
#include "llvm/Support/CommandLine.h"
#include "llvm/Support/FileSystem.h"
#include "llvm/Support/Path.h"

using namespace clang::tooling;
using namespace llvm;

#define CPP_COMP 1
#define COMPILER_NAME "cdt-cpp"
#include <compiler_options.hpp>

#include <set>
#include <sstream>

using namespace llvm;

int main(int argc, const char **argv) {

   // fix to show version info without having to have any other arguments
   for (int i=0; i < argc; i++) {
     if (argv[i] == std::string("-v")) {
       sysio::cdt::environment::exec_subprogram("clang++", {"-v"});
       return 0;
     }
   }

   cl::SetVersionPrinter([](llvm::raw_ostream& os) {
         os << COMPILER_NAME << " version " << "${VERSION_FULL}" << "\n";
   });
   cl::ParseCommandLineOptions(argc, argv, std::string(COMPILER_NAME)+" (Sysio C++ -> WebAssembly compiler)");
   Options opts = CreateOptions();

   std::vector<std::string> outputs;
   try {
      // Run cdt-codegen to generate .dispatch.cpp and .abi
      // Run for: (1) any wasm link build, or (2) compile-only with explicit -contract flag
      // When -contract is not given, the contract name is derived from the output filename.
      bool is_wasm_build = !opts.pp_only && !opts.native;
      bool should_run_codegen = is_wasm_build && (opts.link || opts.has_contract_opt);
      if (should_run_codegen) {
         std::vector<std::string> codegen_args;
         // Pass --contract when explicitly specified by user (or by CMake macro),
         // or when --abigen is set (strict contract name matching required for ABI generation).
         // When neither is set (plain link build), let cdt-codegen auto-detect from source.
         if (opts.has_contract_opt || opts.abigen) {
            codegen_args.push_back("--contract");
            codegen_args.push_back(opts.abigen_contract);
         }
         codegen_args.push_back("--output-dir");

         // Determine output directory from output filename
         llvm::SmallString<256> out_dir(opts.output_fn);
         llvm::sys::path::remove_filename(out_dir);
         std::string output_dir = out_dir.str().empty() ? "." : std::string(out_dir.str());
         codegen_args.push_back(output_dir);

         if (opts.abi_version.first > 0) {
            codegen_args.push_back("--abi-version");
            codegen_args.push_back(std::to_string(opts.abi_version.first) + "." + std::to_string(opts.abi_version.second));
         }

         // Only suppress ABI generation when explicitly not linking (compile-only mode)
         // and abigen was not requested. When linking, always generate ABI.
         if (!opts.abigen && !opts.link) {
            codegen_args.push_back("--no-abigen");
         }

         // Build --cxx options string from compiler options
         std::string cxx_opts;
         for (const auto& opt : opts.comp_options) {
            if (!cxx_opts.empty()) cxx_opts += " ";
            cxx_opts += opt;
         }
         codegen_args.push_back("--cxx");
         codegen_args.push_back(cxx_opts);

         for (const auto& r : opts.abigen_resources) {
            codegen_args.push_back("-R");
            codegen_args.push_back(r);
         }

         for (auto& input : opts.inputs) {
            codegen_args.push_back(input);
         }

         if (!sysio::cdt::environment::exec_subprogram("cdt-codegen", codegen_args)) {
            return -1;
         }
      }

      // Determine output directory for codegen artifacts
      llvm::SmallString<256> out_dir_buf(opts.output_fn);
      llvm::sys::path::remove_filename(out_dir_buf);
      std::string codegen_output_dir = out_dir_buf.str().empty() ? "." : std::string(out_dir_buf.str());
      bool is_contract_build = should_run_codegen;

      // Compile each input file. For contract builds, if a .actions.cpp was generated,
      // compile it instead (it #includes the original source and adds action wrappers).
      for (auto input : opts.inputs) {
         std::vector<std::string> new_opts = opts.comp_options;
         std::string output;
         std::string compile_input = input;

         auto src = SmallString<64>(input);
         llvm::sys::path::remove_filename(src);
         std::string source_path = src.str().empty() ? "." : std::string(src.str());
         new_opts.insert(new_opts.begin(), "-I" + source_path);

         // For contract builds, use the generated .actions.cpp if it exists
         if (is_contract_build) {
            auto basename = input.substr(input.rfind('/') + 1);
            std::string actions_file = codegen_output_dir + "/" + basename + ".actions.cpp";
            if (llvm::sys::fs::exists(actions_file)) {
               compile_input = actions_file;
            }
         }

         if (!opts.link) {
            output = opts.output_fn.empty() ? "a.out" : opts.output_fn;
         } else {
            SmallString<64> res;
            llvm::sys::fs::createTemporaryFile("antelope", ".o", res);
            output = std::string(res.c_str());
         }

         new_opts.insert(new_opts.begin(), {"-o", output});
         outputs.push_back(output);

         new_opts.insert(new_opts.begin(), compile_input);
         new_opts.insert(new_opts.begin(), "-xc++");

         if (!sysio::cdt::environment::exec_subprogram("clang++", new_opts)) {
            return -1;
         }
      }

      // Compile the generated dispatch file (contains apply() entry point)
      if (is_contract_build) {
         std::string dispatch_file = codegen_output_dir + "/" + opts.abigen_contract + ".dispatch.cpp";
         if (llvm::sys::fs::exists(dispatch_file)) {
            std::vector<std::string> dispatch_opts = opts.comp_options;
            SmallString<64> res;
            llvm::sys::fs::createTemporaryFile("dispatch", ".o", res);
            std::string dispatch_output = std::string(res.c_str());

            dispatch_opts.insert(dispatch_opts.begin(), {"-o", dispatch_output});
            dispatch_opts.insert(dispatch_opts.begin(), dispatch_file);
            dispatch_opts.insert(dispatch_opts.begin(), "-xc++");

            if (!sysio::cdt::environment::exec_subprogram("clang++", dispatch_opts)) {
               return -1;
            }
            outputs.push_back(dispatch_output);
         }
      }

      // When compiling with -c and a dispatch file was generated, merge the .o files
      // using wasm-ld --relocatable so CMake sees a single .o output
      if (!opts.link && opts.has_contract_opt && outputs.size() > 1) {
         std::string final_output = outputs[0];
         std::string temp_main = final_output + ".main.tmp";
         llvm::sys::fs::rename(final_output, temp_main);

         std::vector<std::string> merge_opts = {"--relocatable", "-o", final_output, temp_main};
         for (size_t i = 1; i < outputs.size(); i++) {
            merge_opts.push_back(outputs[i]);
         }
         if (!sysio::cdt::environment::exec_subprogram("wasm-ld", merge_opts)) {
            llvm::sys::fs::remove(temp_main);
            for (size_t i = 1; i < outputs.size(); i++)
               llvm::sys::fs::remove(outputs[i]);
            return -1;
         }
         llvm::sys::fs::remove(temp_main);
         for (size_t i = 1; i < outputs.size(); i++)
            llvm::sys::fs::remove(outputs[i]);
      }

   } catch (std::runtime_error& err) {
      llvm::errs() << err.what() << '\n';
      return -1;
   }

   if (opts.link) {
      std::vector<std::string> new_opts = opts.ld_options;
      for (auto input : outputs) {
         new_opts.insert(new_opts.begin(), input);
      }

      if (!sysio::cdt::environment::exec_subprogram("cdt-ld", new_opts)) {
         for (auto input : outputs) {
            llvm::sys::fs::remove(input);
         }
         return -1;
      }
      for (auto input : outputs) {
         llvm::sys::fs::remove(input);
      }
      if ( !llvm::sys::fs::exists( opts.output_fn ) ) {
         return -1;
      }

// need to generate dSYM for mac OSX
#ifdef __APPLE__
      if (opts.native) {
         if (opts.debug) {
            if (!sysio::cdt::environment::exec_subprogram("dsymutil", std::vector<std::string>{opts.output_fn}, true)) {
               return -1;
            }
         }
      }
#endif
   }

  return 0;
}
